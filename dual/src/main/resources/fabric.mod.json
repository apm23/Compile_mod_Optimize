{
  "schemaVersion": 1,
  "id": "compile_mod_dual",
  "version": "${version}",
  "name": "Compile Mod Dual",
  "description": "Consolidated client+server custom modules for Minecraft 26.2.",
  "authors": ["apm23"],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.anjas.linkedshulker.LinkedShulkerMod",
      "com.anjas.fuelrecipe.FuelRecipeMod",
      "com.anjas.forceanvil.ForceAnvilMod",
      "com.anjas.custominventory.CustomHotbarInventory",
      "apm23.compilemod.dual.functional.godvillager.GodVillagerRegistry",
      "com.anjas.godvillagers.TaczBridgeBootstrap"
    ],
    "client": [
      "com.anjas.custominventory.client.CustomHotbarInventoryClient"
    ]
  },
  "mixins": [
    "fuelrecipe.mixins.json",
    "forceanvil.mixins.json",
    "custom_hotbar_inventory.client.mixins.json",
    "godvillagers.compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
